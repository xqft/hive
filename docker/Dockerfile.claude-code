FROM node:22-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG CLAUDE_CODE_VERSION=stable
ENV PATH="/root/.local/bin:${PATH}"

# Install system dependencies (curl needed for Claude CLI install below)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget jq ripgrep sudo tmux \
    python3 python3-pip \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright's Chromium + system deps (for browser automation MCP)
RUN npx -y playwright install --with-deps chromium

# Install Claude Code CLI (as root, then copy for hive user)
RUN curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_CODE_VERSION}"

# Verify install
RUN command -v claude && claude --version >/dev/null

# Create non-root user (Claude CLI refuses --dangerously-skip-permissions as root)
RUN useradd -m -s /bin/bash hive \
    && cp -rL /root/.local /home/hive/.local \
    && chown -R hive:hive /home/hive/.local \
    && mkdir -p /workspace && chown hive:hive /workspace \
    && echo 'hive ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Copy Hive SDK files for persistent agent mode
COPY sdk/hive_agent.js sdk/hive_mcp_bridge.js sdk/message_batcher.js sdk/message_channel.js /opt/hive/
COPY sdk/package.json sdk/package-lock.json /opt/hive/
RUN cd /opt/hive && npm ci --omit=dev

COPY docker/entrypoint-agent.sh /usr/local/bin/entrypoint-agent.sh
RUN chmod +x /usr/local/bin/entrypoint-agent.sh

USER hive
ENV PATH="/home/hive/.local/bin:${PATH}"

# Pre-configure Claude Code to skip first-run onboarding (theme picker,
# permission confirmation, etc.). Auth is handled at runtime via
# CLAUDE_CODE_OAUTH_TOKEN env var passed by Hive.Container.
RUN mkdir -p /home/hive/.claude && \
    printf '%s\n' '{"skipDangerousModePermissionPrompt": true, "effortLevel": "max"}' \
      > /home/hive/.claude/settings.json && \
    printf '%s\n' '{"numStartups": 1, "hasCompletedOnboarding": true, "lastOnboardingVersion": "99.0.0", "installMethod": "native"}' \
      > /home/hive/.claude.json

# Playwright MCP server — available to Claude Code in /workspace
RUN printf '%s\n' '{"mcpServers":{"playwright":{"command":"npx","args":["@playwright/mcp@latest","--headless","--browser","chromium","--no-sandbox"]}}}' \
      > /workspace/.mcp.json

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint-agent.sh"]
